APP_ARTWORK_LIFETIME=30 # How long (days) an uploaded artwork stays hosted before it is deleted (unless it gets renewed).
APP_CLIENT_TOKEN_LIFETIME=90 # How long (days) clients can access the API without needing to register themselves again.
APP_DISABLE_USER_REGISTRATIONS=false # Whether to disable user registration or not.
APP_INSTANCE_IDENTIFIER='RandomString' # The identifier for this instance. Encore knows to reset its local cache if it changes with a response.
APP_PUBLIC_CLIENT_REGISTRATION=false # Whether this is a public instance or not. Disable to allow anyone to connect to it with Encore.
APP_USER_TOKEN_LIFETIME=30 # How long (days) a login session token stays valid before the user has to authenticate again.

DATABASE_DRIVER='postgresql' # `postgresql` or `mysql`
DATABASE_HOST='127.0.0.1'
DATABASE_PORT=5432
DATABASE_USERNAME='encore'
DATABASE_PASSWORD='IWasWearingHelloKittySocksWhileWritingThis'
DATABASE_NAME='encore'
